# Server (app listens on port 3002 in dev, preview and production)
PORT=3002
HOST=0.0.0.0

# Public site URL used for canonical URLs, hreflang, sitemap and Open Graph
NUXT_PUBLIC_SITE_URL=https://movtigroup.me

# Supported Languages (en default, fa with /fa prefix)
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,fa
